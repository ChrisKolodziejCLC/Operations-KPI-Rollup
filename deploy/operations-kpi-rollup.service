[Unit]
Description=CLC Operations KPI Rollup read-only pilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=operations-kpi
Group=operations-kpi
WorkingDirectory=/opt/clc/operations-kpi-rollup/current
Environment=PYTHONPATH=/opt/clc/operations-kpi-rollup/current/src
Environment=KPI_DATA_MODE=live
Environment=KPI_BIND_HOST=0.0.0.0
Environment=KPI_PORT=5193
Environment=KPI_TIMEZONE=America/Indiana/Indianapolis
Environment=KPI_SNAPSHOT_DIR=/var/lib/operations-kpi-rollup/snapshots
Environment=KPI_SQL_CREDENTIAL_NAME=operations-kpi-qpts-ro
Environment=KPI_SQL_EXPECTED_SERVER=brak
Environment="KPI_SQL_EXPECTED_DATABASE=Production Tracking (Version 1.0.0)SQL"
Environment=KPI_SQL_EXPECTED_USER=OperationsKpiRollup_RO
Environment=KPI_SQL_PROCEDURE_HASH=7AA6DCC3A056553C3945EF7474FE15B44565BD9C450E97030DD9970CBF569936
Environment=KPI_PROCESS_TIME_PROCEDURE_HASH=EB4A024B32C8D92894046555CD8D002D128F5DDE7FD6C9CD96A5428068C51476
Environment=KPI_QUALITY_CHARTS_PROCEDURE_HASH=480D182DB7B455C21136FE8E073FF75C9A907AB414D34E91362055A3BB3ABA64
Environment=KPI_ROSTER_PROCEDURE_HASH=0EACA9821E82112D9C93DD21A4CBE78B49D5F2A8E2DAF197AD40BA07BFD2E159
Environment=KPI_AUTH_PORT=5196
Environment=KPI_AUTH_BIND_HOST=0.0.0.0
Environment=KPI_AUTH_KEYTAB=/etc/clc/operations-kpi-rollup/auth/http.keytab
Environment=KPI_AUTH_TLS_CERT=/etc/clc/operations-kpi-rollup/auth/tls-fullchain.pem
Environment=KPI_AUTH_TLS_KEY=/etc/clc/operations-kpi-rollup/auth/tls.key
Environment=KPI_AUTH_ALLOWLIST=/etc/clc/operations-kpi-rollup/auth/allowed-principals.json
Environment=KPI_AUTH_SERVICE_PRINCIPAL=HTTP/kpi.eliteenterprisesinc.com@ELITEENTERPRISESINC.COM
Environment=KRB5RCACHETYPE=none
Environment=KPI_SQL_QUERY_TIMEOUT_SECONDS=300
Environment=KPI_REFRESH_FRESHNESS_SECONDS=600
Environment=KPI_AUTO_REFRESH_SECONDS=600
LoadCredentialEncrypted=operations-kpi-qpts-ro:/etc/credstore.encrypted/operations-kpi-qpts-ro
StateDirectory=operations-kpi-rollup
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -m operations_kpi_rollup.web
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
