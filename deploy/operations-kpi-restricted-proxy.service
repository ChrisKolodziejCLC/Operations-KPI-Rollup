[Unit]
Description=CLC Operations KPI restricted Entra HTTPS proxy
After=network-online.target operations-kpi-restricted.service
Wants=network-online.target
Requires=operations-kpi-restricted.service

[Service]
Type=simple
User=operations-kpi
Group=operations-kpi
WorkingDirectory=/opt/clc/operations-kpi-rollup/current
Environment=PYTHONPATH=/opt/clc/operations-kpi-rollup/current/src
EnvironmentFile=/etc/operations-kpi-restricted/proxy.env
Environment=KPI_RESTRICTED_PROXY_BIND_HOST=0.0.0.0
Environment=KPI_RESTRICTED_PROXY_PORT=5195
Environment=KPI_RESTRICTED_PROXY_BACKEND_HOST=127.0.0.1
Environment=KPI_RESTRICTED_PROXY_BACKEND_PORT=5194
LoadCredentialEncrypted=operations-kpi-restricted-proxy-allowed-users:/etc/credstore.encrypted/operations-kpi-restricted-proxy-allowed-users
LoadCredentialEncrypted=operations-kpi-restricted-proxy-cookie-key:/etc/credstore.encrypted/operations-kpi-restricted-proxy-cookie-key
LoadCredentialEncrypted=operations-kpi-restricted-proxy-tls-certificate:/etc/credstore.encrypted/operations-kpi-restricted-proxy-tls-certificate
LoadCredentialEncrypted=operations-kpi-restricted-proxy-tls-key:/etc/credstore.encrypted/operations-kpi-restricted-proxy-tls-key
LoadCredentialEncrypted=operations-kpi-restricted-proxy-client-certificate:/etc/credstore.encrypted/operations-kpi-restricted-proxy-client-certificate
LoadCredentialEncrypted=operations-kpi-restricted-proxy-client-key:/etc/credstore.encrypted/operations-kpi-restricted-proxy-client-key
ExecStart=/usr/bin/python3 -m operations_kpi_rollup.restricted_proxy
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
